# ProofPatch Environment Configuration

# --------------------------
# Nebius AI Cloud / Token Factory Settings
# --------------------------
# Replace with your actual Nebius API key. If left as 'mock_key', the application
# will run in mock mode for testing without consuming credits.
NEBIUS_API_KEY="mock_key"

# The base URL for the Nebius API. Default is typically the studio endpoint.
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1/"

# The specific NVIDIA open-source model to use for inference.
NEBIUS_MODEL_NAME="nvidia/Llama-3.1-Nemotron-70B-Instruct"

