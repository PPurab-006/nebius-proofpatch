# Patchworks Environment Configuration

# --------------------------
# Nebius AI Cloud / Token Factory Settings
# --------------------------
# Replace with your actual Nebius API key. If left as 'mock_key', the application
# will run in mock mode for testing without consuming credits.
NEBIUS_API_KEY="mock_key"

# The base URL for the Nebius API. Default is typically the studio endpoint.
NEBIUS_BASE_URL="https://api.studio.nebius.ai/v1/"

# The specific NVIDIA open-source model to use for inference.
NEBIUS_MODEL_NAME="nvidia/nemotron-3-super-120b-a12b"

# Inference timeout deadline in seconds (default 60.0s).
NEBIUS_TIMEOUT="60.0"

# --------------------------
# GitHub Integration & PR Automation Settings (Optional)
# --------------------------
# You can connect a GitHub Personal Access Token (PAT) dynamically in the Patchworks UI,
# or provide server-level defaults below. Tokens are never exposed to the frontend or logs.
# Required permissions: repo (for private repositories) or fine-grained Contents & Pull Requests read/write.
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --------------------------
# Supabase Persistence & Authentication Settings (Optional)
# --------------------------
# Connect a Supabase project to enable persistent accounts, user-isolated GitHub connections,
# and cloud-synced repair histories across deployments and browser sessions.
# If unset, Patchworks runs in local guest/demo mode without cross-session database persistence.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Server-side only: Used for user token verification and RLS data operations.
# NEVER expose this key to the client or frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Dedicated 256-bit base64-encoded key for AES-256 / Fernet token encryption at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATCHWORKS_ENCRYPTION_KEY=""
